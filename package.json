{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22 <25",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "type-check": "vue-tsc --noEmit",
